# Runtime: dev, test or production
ENVIRONMENT=dev
APP_DEBUG=false
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Local default. Production also accepts postgres:// or postgresql:// provider
# URLs; the application converts them to asyncpg and translates sslmode safely.
DATABASE_URL=sqlite+aiosqlite:///./nebula_dev.db
# auto detects common pooler/PgBouncer hosts. Set transaction explicitly when
# a provider uses an unrecognizable transaction-pooler endpoint.
DATABASE_POOL_MODE=auto
# Prefer a provider's direct PostgreSQL endpoint for Alembic/release jobs.
# Leave empty locally; if it is omitted, migrations safely reuse DATABASE_URL.
MIGRATION_DATABASE_URL=
MIGRATION_DATABASE_POOL_MODE=auto
AUTO_MIGRATE=true
LOAD_SEED_DATA=true

# Generate a unique value with at least 32 random characters. The example is
# intentionally rejected in production.
AUTH_SECRET=dev-only-nebula-secret-change-before-production
SESSION_LIFETIME_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# The production SPA and /api are served from this one origin by lambda_handler.py.
# Never use * because administrative cookies are enabled.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_SITE_URL=http://localhost:3000

# Optional email delivery. Leave RESEND_API_KEY empty to keep messages pending.
RESEND_API_KEY=
ADMIN_EMAIL=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Nébula Beauty MX
