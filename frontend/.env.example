# Always empty: development uses Vite's /api proxy and production uses
# lambda_handler.py to serve the SPA and API from one origin.
VITE_API_BASE_URL=
# Production: use one exact HTTPS DNS origin with no path, credentials, query,
# fragment, IP literal, explicit :443, or trailing slash.
VITE_PUBLIC_SITE_URL=http://localhost:3000
VITE_APP_ENVIRONMENT=dev
VITE_APP_TITLE=Nébula Beauty MX
VITE_APP_DESCRIPTION=Aparta cosméticos y paga únicamente al recibir.
